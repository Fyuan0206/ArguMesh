# ============================================================
# ArguMesh 本地配置(全部可选,不配置也能直接运行)
# 复制为 .env 后按需填写:Copy-Item .env.example .env
# ============================================================

# 数据库:默认本地 SQLite 文件(data/argumesh.db),零云服务依赖。
# 也可以指向任意 libsql 远程库(libsql://...,需 DATABASE_AUTH_TOKEN)。
# DATABASE_URL=file:./data/argumesh.db
# DATABASE_AUTH_TOKEN=

# API 服务端口(默认 8787;Vite 开发服务器会把 /api 代理到该端口)
# PORT=8787

# 会话签名密钥:不配置时首次启动自动生成并持久化到 data/session-secret.key
# APP_ACCESS_TOKEN=

# AI 能力(可选):不配置时 AI 提取 / 阅读问答 / Paper Card 功能会提示"AI 未配置"。
# 方式一(推荐):任意 OpenAI 兼容服务,可配置多家,格式为 JSON 数组:
# AI_PROVIDERS=[{"id":"stepfun","label":"StepFun","baseUrl":"https://api.stepfun.com/v1","apiKey":"sk-...","models":["step-3.7-flash"]}]
# 方式二:单家 StepFun 兼容配置:
# STEPFUN_BASE_URL=https://api.stepfun.com/v1
# STEPFUN_API_KEY=sk-...
# STEPFUN_MODEL=step-3.7-flash
# 可选:AI_MODELS 用逗号分隔覆盖可选模型列表
