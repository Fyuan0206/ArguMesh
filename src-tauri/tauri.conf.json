{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArguMesh",
  "version": "3.3.3",
  "identifier": "com.argumesh.desktop",
  "build": {
    "frontendDist": "../src-tauri/assets",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ArguMesh 论脉",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Productivity",
    "shortDescription": "本地优先、开源的科研 personal agent",
    "longDescription": "ArguMesh 论脉结合项目里的论文与证据，协助梳理发现、规划实验和修改论文。研究数据保存在本地 SQLite，用户按需接入自己的 AI 模型。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "SimpChinese"]
      }
    },
    "resources": {
      "../build/sidecar/": "sidecar/"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.icns"]
  }
}
