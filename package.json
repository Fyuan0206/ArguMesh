{
  "name": "argumesh",
  "version": "3.2.4",
  "private": true,
  "type": "module",
  "description": "ArguMesh 论脉 — 把证据连成研究脉络的本地研究工作台(开源版)",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,green \"pnpm:dev:api\" \"pnpm:dev:web\"",
    "dev:api": "node --watch --import tsx server/node.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/node.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:backup": "tsx scripts/backup-database.ts",
    "db:studio": "drizzle-kit studio",
    "test": "node ./node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "test:watch": "node ./node_modules/vitest/vitest.mjs --config vitest.config.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@hono/node-server": "^1.14.0",
    "@libsql/client": "^0.17.4",
    "@phosphor-icons/react": "^2.1.10",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.1",
    "pdfjs-dist": "^4.10.38",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.28.0",
    "remark-gfm": "^4.0.1",
    "tesseract.js": "^7.0.0",
    "typebox": "1.3.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^15.11.7",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vite": "^6.4.2",
    "vitest": "^2.1.9"
  }
}
